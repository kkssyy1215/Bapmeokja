# 백엔드까지 함께 실행할 때는 false, 발표용 오프라인 시연은 true로 설정합니다.
EXPO_PUBLIC_USE_MOCKS=false

# 웹/iOS 시뮬레이터 기준입니다. 실기기는 127.0.0.1 대신 개발 PC의 LAN IP를 사용하세요.
EXPO_PUBLIC_API_URL=http://127.0.0.1:8080/v1

# docker compose 로컬 실행용 값입니다. 운영에서는 반드시 비밀값을 별도로 주입하세요.
MYSQL_PASSWORD=bapmeokja-local
MYSQL_ROOT_PASSWORD=bapmeokja-root-local
JWT_SECRET=local-development-secret-change-before-production-2026

# 음식 사진 AI 분석(Google AI Studio 무료 키). 비워 두면 파일명 기반 시연용 분석기를 사용합니다.
GEMINI_API_KEY=
# 로컬 테스트 반복 실행을 위해 기본 false. 운영 프로필은 항상 true입니다.
RATE_LIMIT_ENABLED=false
